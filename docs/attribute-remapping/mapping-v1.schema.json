{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:papaya:attribute-mapping:1.0",
  "title": "Papaya attribute mapping v1.0",
  "description": "Structural validation only. Destination uniqueness, pointer restrictions, byte/work limits, source values and cross-field constraints require the semantic validator described in index.html.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "targetSchema"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "targetSchema": {
      "const": "papaya.normalized-trace.v1"
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^/metadata/(?:[^~]|~0|~1)*$"
          },
          "to": {
            "enum": [
              "/sessionId",
              "/conversationId",
              "/userId",
              "/organizationId",
              "/workflowKey",
              "/workflowLabel",
              "/conversational",
              "/group/name",
              "/group/value",
              "/metadata/thread_id"
            ]
          },
          "onMissing": {
            "enum": [
              "error",
              "skip"
            ],
            "default": "error"
          },
          "onConflict": {
            "enum": [
              "error",
              "replace"
            ],
            "default": "error"
          }
        }
      }
    },
    "span": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^/attributes/(?:[^~]|~0|~1)*$"
          },
          "to": {
            "enum": [
              "/modelRef/provider",
              "/modelRef/requested",
              "/modelRef/used",
              "/usage/inputTokens",
              "/usage/outputTokens",
              "/usage/totalTokens",
              "/usage/cacheReadInputTokens",
              "/usage/cacheCreationInputTokens",
              "/usage/reasoningTokens",
              "/usage/costUsd",
              "/tool/name"
            ]
          },
          "onMissing": {
            "enum": [
              "error",
              "skip"
            ],
            "default": "error"
          },
          "onConflict": {
            "enum": [
              "error",
              "replace"
            ],
            "default": "error"
          }
        }
      }
    },
    "hitl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "cardinality",
            "fields"
          ],
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^/metadata/(?:[^~]|~0|~1)*$"
            },
            "cardinality": {
              "enum": [
                "one",
                "many"
              ]
            },
            "fields": {
              "type": "array",
              "minItems": 4,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"
                  },
                  "to": {
                    "enum": [
                      "/phase",
                      "/correlationId",
                      "/spanId",
                      "/occurredAt",
                      "/nativeInterruptId"
                    ]
                  },
                  "onMissing": {
                    "enum": [
                      "error",
                      "skip"
                    ],
                    "default": "error"
                  },
                  "onConflict": {
                    "enum": [
                      "error"
                    ],
                    "default": "error"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "cardinality"
          ],
          "description": "Opt-in scalar application ID for exactly one complete framework HITL boundary; phase, span and time come from capture. Missing or multiple boundaries fail explicitly.",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^/metadata/(?:[^~]|~0|~1)*$"
            },
            "cardinality": {
              "const": "scalar"
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "trace"
      ]
    },
    {
      "required": [
        "span"
      ]
    },
    {
      "required": [
        "hitl"
      ]
    }
  ]
}
