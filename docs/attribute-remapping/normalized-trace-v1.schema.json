{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:papaya:normalized-trace:v1",
  "title": "Papaya normalized trace v1 — normalization input contract",
  "description": "PapayaTrace fields snapshot from TypeSpec-generated OpenAPI plus the metadata mapping control schema. This is not the canonical database write schema. Runtime semantic validation is additionally required.",
  "$ref": "#/$defs/PapayaTrace",
  "$defs": {
    "PapayaTrace": {
      "type": "object",
      "required": [
        "traceId",
        "runId",
        "rootSpanId",
        "spans"
      ],
      "properties": {
        "traceId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "organizationId": {
          "type": "string"
        },
        "workflowKey": {
          "type": "string"
        },
        "workflowLabel": {
          "type": "string"
        },
        "conversational": {
          "type": "boolean"
        },
        "group": {
          "$ref": "#/$defs/PapayaTraceGroup"
        },
        "rootSpanId": {
          "type": "string"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PapayaSpan"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PapayaEvent"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {},
          "properties": {
            "papaya.remap": {
              "$ref": "#/$defs/PapayaRemapConfig"
            }
          }
        },
        "hitlEvents": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/PapayaRemapHitlEvent"
          },
          "description": "Typed application approval boundaries. Generated by scalar/explicit-event mapping or supplied directly; semantic validation always applies."
        }
      }
    },
    "PapayaTraceGroup": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "description": "One customer-defined observability grouping dimension for this trace."
    },
    "PapayaSpan": {
      "type": "object",
      "required": [
        "spanId",
        "name",
        "kind",
        "startedAt",
        "status"
      ],
      "properties": {
        "spanId": {
          "type": "string"
        },
        "parentSpanId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PapayaSpanKind"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/CanonicalStatus"
        },
        "error": {
          "$ref": "#/$defs/PapayaError"
        },
        "inputPayload": {
          "$ref": "#/$defs/PapayaPayloadRef"
        },
        "outputPayload": {
          "$ref": "#/$defs/PapayaPayloadRef"
        },
        "modelRef": {
          "$ref": "#/$defs/PapayaModelRef"
        },
        "usage": {
          "$ref": "#/$defs/PapayaUsage"
        },
        "tool": {
          "$ref": "#/$defs/PapayaToolRef"
        },
        "retrieval": {
          "$ref": "#/$defs/PapayaRetrievalRef"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {}
        }
      }
    },
    "PapayaSpanKind": {
      "type": "string",
      "enum": [
        "workflow",
        "agent",
        "llm",
        "tool",
        "retrieval",
        "embedding",
        "reranker",
        "memory",
        "state_transition",
        "guardrail",
        "router",
        "human",
        "handoff",
        "evaluator",
        "other"
      ]
    },
    "CanonicalStatus": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "partial",
        "unknown"
      ]
    },
    "PapayaError": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "PapayaPayloadRef": {
      "type": "object",
      "required": [
        "contentType",
        "redactionState"
      ],
      "properties": {
        "contentType": {
          "$ref": "#/$defs/PayloadContentType"
        },
        "value": {},
        "contentRef": {
          "type": "string"
        },
        "redactionState": {
          "$ref": "#/$defs/CaptureMode"
        },
        "byteLength": {
          "type": "integer",
          "format": "int32"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "PayloadContentType": {
      "type": "string",
      "enum": [
        "text",
        "json",
        "messages",
        "binary_ref"
      ]
    },
    "CaptureMode": {
      "type": "string",
      "enum": [
        "metadata",
        "redacted",
        "full"
      ]
    },
    "PapayaModelRef": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "requested": {
          "type": "string"
        },
        "used": {
          "type": "string"
        }
      }
    },
    "PapayaUsage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "format": "int32"
        },
        "outputTokens": {
          "type": "integer",
          "format": "int32"
        },
        "totalTokens": {
          "type": "integer",
          "format": "int32"
        },
        "cacheReadInputTokens": {
          "type": "integer",
          "format": "int32"
        },
        "cacheCreationInputTokens": {
          "type": "integer",
          "format": "int32"
        },
        "reasoningTokens": {
          "type": "integer",
          "format": "int32"
        },
        "costUsd": {
          "type": "number",
          "format": "double"
        },
        "operationCount": {
          "type": "integer",
          "format": "int32"
        },
        "llmCallCount": {
          "type": "integer",
          "format": "int32"
        },
        "toolCallCount": {
          "type": "integer",
          "format": "int32"
        },
        "toolErrorCount": {
          "type": "integer",
          "format": "int32"
        },
        "hasFeedback": {
          "type": "boolean"
        },
        "hasRawRef": {
          "type": "boolean"
        },
        "pricingSource": {
          "$ref": "#/$defs/PricingSource"
        },
        "costKind": {
          "$ref": "#/$defs/CostKind"
        },
        "pricingRateId": {
          "type": "string"
        },
        "pricingInputPer1k": {
          "type": "number",
          "format": "double"
        },
        "pricingOutputPer1k": {
          "type": "number",
          "format": "double"
        },
        "pricingCurrency": {
          "type": "string"
        },
        "pricingRegion": {
          "type": "string"
        },
        "pricingRateUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pricedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PricingSource": {
      "type": "string",
      "enum": [
        "provider",
        "papaya_catalog",
        "customer",
        "unknown"
      ]
    },
    "CostKind": {
      "type": "string",
      "enum": [
        "observed",
        "estimated",
        "unavailable"
      ]
    },
    "PapayaToolRef": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "$ref": "#/$defs/PapayaPayloadRef"
        },
        "result": {
          "$ref": "#/$defs/PapayaPayloadRef"
        }
      }
    },
    "PapayaRetrievalRef": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/PapayaPayloadRef"
        },
        "documents": {
          "$ref": "#/$defs/PapayaPayloadRef"
        },
        "documentCount": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "PapayaEvent": {
      "type": "object",
      "required": [
        "eventId",
        "name",
        "occurredAt"
      ],
      "properties": {
        "eventId": {
          "type": "string"
        },
        "spanId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "format": "int32"
        },
        "payload": {
          "$ref": "#/$defs/PapayaPayloadRef"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {}
        }
      }
    },
    "PapayaRemapHitlEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "correlationType",
        "correlationId",
        "spanId",
        "occurredAt"
      ],
      "properties": {
        "phase": {
          "enum": [
            "pause",
            "resume"
          ]
        },
        "correlationType": {
          "const": "application"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "spanId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "nativeInterruptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "PapayaRemapConfig": {
      "title": "Papaya attribute mapping v1.0",
      "description": "Structural validation only. Destination uniqueness, pointer restrictions, byte/work limits, source values and cross-field constraints require the semantic validator described in index.html.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "targetSchema"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "targetSchema": {
          "const": "papaya.normalized-trace.v1"
        },
        "trace": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^/metadata/(?:[^~]|~0|~1)*$"
              },
              "to": {
                "enum": [
                  "/sessionId",
                  "/conversationId",
                  "/userId",
                  "/organizationId",
                  "/workflowKey",
                  "/workflowLabel",
                  "/conversational",
                  "/group/name",
                  "/group/value",
                  "/metadata/thread_id"
                ]
              },
              "onMissing": {
                "enum": [
                  "error",
                  "skip"
                ],
                "default": "error"
              },
              "onConflict": {
                "enum": [
                  "error",
                  "replace"
                ],
                "default": "error"
              }
            }
          }
        },
        "span": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^/attributes/(?:[^~]|~0|~1)*$"
              },
              "to": {
                "enum": [
                  "/modelRef/provider",
                  "/modelRef/requested",
                  "/modelRef/used",
                  "/usage/inputTokens",
                  "/usage/outputTokens",
                  "/usage/totalTokens",
                  "/usage/cacheReadInputTokens",
                  "/usage/cacheCreationInputTokens",
                  "/usage/reasoningTokens",
                  "/usage/costUsd",
                  "/tool/name"
                ]
              },
              "onMissing": {
                "enum": [
                  "error",
                  "skip"
                ],
                "default": "error"
              },
              "onConflict": {
                "enum": [
                  "error",
                  "replace"
                ],
                "default": "error"
              }
            }
          }
        },
        "hitl": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "cardinality",
                "fields"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^/metadata/(?:[^~]|~0|~1)*$"
                },
                "cardinality": {
                  "enum": [
                    "one",
                    "many"
                  ]
                },
                "fields": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 5,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "from",
                      "to"
                    ],
                    "properties": {
                      "from": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512,
                        "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"
                      },
                      "to": {
                        "enum": [
                          "/phase",
                          "/correlationId",
                          "/spanId",
                          "/occurredAt",
                          "/nativeInterruptId"
                        ]
                      },
                      "onMissing": {
                        "enum": [
                          "error",
                          "skip"
                        ],
                        "default": "error"
                      },
                      "onConflict": {
                        "enum": [
                          "error"
                        ],
                        "default": "error"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "cardinality"
              ],
              "description": "Opt-in scalar application ID for exactly one complete framework HITL boundary; phase, span and time come from capture. Missing or multiple boundaries fail explicitly.",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^/metadata/(?:[^~]|~0|~1)*$"
                },
                "cardinality": {
                  "const": "scalar"
                }
              }
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "trace"
          ]
        },
        {
          "required": [
            "span"
          ]
        },
        {
          "required": [
            "hitl"
          ]
        }
      ]
    }
  }
}
