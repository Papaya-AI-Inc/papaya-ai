{
  "name": "@papaya-ai/tracing",
  "version": "0.1.4",
  "description": "Papaya AI agent trace capture SDK for production apps.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://papaya.fyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Papaya-AI-Inc/papaya-ai.git"
  },
  "bugs": {
    "url": "https://github.com/Papaya-AI-Inc/papaya-ai/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "agentic",
    "observability",
    "tracing",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "vercel-ai-sdk",
    "langchain"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js",
      "default": "./dist/langchain.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "RELEASE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3 <2"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check:node": "node ./scripts/check-node-version.mjs",
    "prebuild": "npm run check:node",
    "prepack": "npm run build",
    "pretest": "npm run check:node",
    "test": "node --import tsx test/sdk.test.ts && node --import tsx test/adoption-marker.test.ts && node --import tsx test/langchain.test.ts && node --import tsx test/provider-matrix.test.ts",
    "pretypecheck": "npm run check:node",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@aws-sdk/client-bedrock-runtime": "3.1093.0",
    "@google/genai": "^2.8.0",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.1",
    "@types/node": "^25.7.0",
    "ai": "^7.0.35",
    "openai": "^6.48.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
